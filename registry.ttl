<https://w3id.org/ro/terms/workflow-run#ContainerImage> a schema:DefinedTerm,
        rdfs:Class ;
    schema:description "A containerization software container image" ;
    schema:name "Container Image" ;
    schema:termCode "ContainerImage" .

<https://w3id.org/ro/terms/workflow-run#DockerImage> a schema:DefinedTerm,
        rdfs:Class ;
    schema:description "A docker container image" ;
    schema:name "Docker Image" ;
    schema:termCode "DockerImage" .

<https://w3id.org/ro/terms/workflow-run#ParameterConnection> a schema:DefinedTerm,
        rdfs:Class ;
    schema:description "A connection between parameters of different applications" ;
    schema:inDefinedTermSet <https://w3id.org/ro/terms/workflow-run#> ;
    schema:name "Parameter Connection" ;
    schema:termCode "ParameterConnection" .

<https://w3id.org/ro/terms/workflow-run#SIFImage> a schema:DefinedTerm,
        rdfs:Class ;
    schema:description "A Singularity Image Format container image" ;
    schema:name "SIF Image" ;
    schema:termCode "SIFImage" .

<https://about.workflowhub.eu/Workflow-RO-Crate/1.0/ro-crate-metadata.json> a schema:CreativeWork ;
    dct:conformsTo <https://w3id.org/ro/crate/1.1>,
        <https://www.researchobject.org/ro-crate/1.2-DRAFT/profiles> ;
    schema:about <https://about.workflowhub.eu/Workflow-RO-Crate/1.0/> ;
    schema:creator <https://orcid.org/0000-0001-9842-9718> ;
    schema:license <http://spdx.org/licenses/CC0-1.0> .

<https://trefx.uk/5s-crate/0.4/ro-crate-metadata.json> a schema:CreativeWork ;
    dct:conformsTo <https://w3id.org/ro/crate/1.2-DRAFT> ;
    schema:about <https://w3id.org/5s-crate/0.4> .

<https://www.iana.org/assignments/named-information#sha-512> a schema:DefinedTerm ;
    schema:name "sha-512 algorithm" .

<https://www.researchobject.org/workflow-run-crate/profiles/0.5/process_run_crate/ro-crate-preview.html> a schema:CreativeWork ;
    schema:about "https://w3id.org/ro/wfrun/process/0.5" ;
    schema:encodingFormat "text/html" ;
    schema:isBasedOn <https://www.researchobject.org/workflow-run-crate/profiles/0.5/process_run_crate/ro-crate-metadata.json> ;
    schema:license <http://spdx.org/licenses/CC0-1.0> ;
    schema:name "RO-Crate preview of the Process Run Crate profile" .

<https://www.researchobject.org/workflow-run-crate/profiles/0.5/provenance_run_crate/ro-crate-preview.html> a schema:CreativeWork ;
    schema:about "https://w3id.org/ro/wfrun/provenance/0.5" ;
    schema:encodingFormat "text/html" ;
    schema:isBasedOn <https://www.researchobject.org/workflow-run-crate/profiles/0.5/provenance_run_crate/ro-crate-metadata.json> ;
    schema:license <http://spdx.org/licenses/CC0-1.0> ;
