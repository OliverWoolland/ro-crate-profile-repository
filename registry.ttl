<https://about.workflowhub.eu/Workflow-RO-Crate/1.0/> a schema:Dataset ;
    schema:author <https://orcid.org/0000-0001-9842-9718>,
        <https://orcid.org/0000-0002-0048-3300>,
        <https://orcid.org/0000-0003-2130-0865>,
        <https://orcid.org/0000-0003-3156-2105> ;
    schema:datePublished "2023-03-13T10:43:00Z" ;
    schema:description """This is the Profile Crate for Workflow RO-Crate. Workflow RO-Crates are a specialization of RO-Crate for packaging an executable workflow with all necessary documentation. It is aligned with, and intends to strictly extend, the more general Bioschemas ComputationalWorkflow profile.

WorkflowHub uses Workflow RO-Crates as an exchange format for users to upload a packaged workflow.""" ;
    schema:hasPart schema:HowTo,
        schema:ImageObject,
        <https://about.workflowhub.eu/Workflow-RO-Crate/1.0/example/>,
        <https://about.workflowhub.eu/Workflow-RO-Crate/1.0/index.html>,
        <https://about.workflowhub.eu/Workflow-RO-Crate/1.0/languages/>,
        <https://about.workflowhub.eu/Workflow-RO-Crate/1.0/licenses/>,
        <https://bioschemas.org/ComputationalWorkflow>,
        <https://bioschemas.org/FormalParameter>,
        <https://w3id.org/ro/crate/1.1/context> ;
    schema:identifier "https://w3id.org/workflowhub/workflow-ro-crate/1.0" ;
    schema:license <https://spdx.org/licenses/BSD-3-Clause> ;
    schema:mentions <https://github.com/KockataEPich/CheckMyCrate/blob/master/CheckMyCrate/profile_library/ro_crate_1.1_basic.json>,
        <https://github.com/inab/WfExS-backend/>,
        <https://pypi.org/project/rocrate/>,
        <https://workflowhub.eu/> ;
    schema:name "Workflow RO-Crate profile" ;
    schema:publisher <https://w3id.org/workflowhub/> ;
    schema:sameAs <https://w3id.org/workflowhub/workflow-ro-crate/1.0> ;
    schema:subjectOf <https://about.workflowhub.eu/Workflow-RO-Crate/1.0/ro-crate-preview.html> ;
    schema:version "1.0.3" ;
    schema:workExample <https://about.workflowhub.eu/Workflow-RO-Crate/1.0/example/> .

