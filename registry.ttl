<https://www.researchobject.org/workflow-run-crate/profiles/0.5/workflow_run_crate/ro-crate-preview.html> a schema:CreativeWork ;
    schema:about "https://w3id.org/ro/wfrun/workflow/0.5" ;
    schema:encodingFormat "text/html" ;
    schema:isBasedOn <https://www.researchobject.org/workflow-run-crate/profiles/0.5/workflow_run_crate/ro-crate-metadata.json> ;
    schema:license <http://spdx.org/licenses/CC0-1.0> ;
    schema:name "RO-Crate preview of the Workflow Run Crate profile" .

<./> a schema:CreativeWork ;
    schema:hasPart [ a schema:ItemList ;
            schema:isPartOf <./> ;
            schema:itemListElement <https://w3id.org/5s-crate/0.4>,
                <https://w3id.org/ro/wfrun/process/0.5>,
                <https://w3id.org/ro/wfrun/provenance/0.5>,
                <https://w3id.org/ro/wfrun/workflow/0.5>,
                <https://w3id.org/workflowhub/workflow-ro-crate/1.0> ;
            schema:name "registry of all profiles" ] .

